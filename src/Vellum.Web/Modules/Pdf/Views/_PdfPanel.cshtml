@model Vellum.Modules.Pdf.PdfPanelModel
@using Vellum.Modules.Pdf
@{
    var m = Model;
    var r = m.Record;
    var tz = m.Tz;
}
<div class="card vl-pdf-card" data-pdf-status="@(m.AnyPending ? $"/pdf/status/{r.Id}" : null)">
    <div class="card-header">
        <h3 class="card-title-sm"><i class="bi bi-file-earmark-pdf"></i>PDF renditions</h3>
        <a class="btn btn-sm btn-ghost ms-auto" href="/pdf/record/@r.Id" title="Download this record's print view as PDF (PLT-809)"><i class="bi bi-filetype-pdf"></i>Record PDF</a>
    </div>
    <div class="card-body pt-2">
        @if (m.Marking != null)
        {
            <div class="vl-pdf-note"><i class="bi bi-exclamation-diamond" aria-hidden="true"></i><span>Shown and printed with a <strong>@m.Marking</strong> watermark: this revision isn't the one in force (SAF-043).</span></div>
        }
        @if (m.Pairs.Count == 0)
        {
            <p class="small text-body-secondary mb-2">No files to convert yet.</p>
        }
        <ul class="vl-pdf-list">
            @foreach (var p in m.Pairs)
            {
                var stateLabel = p.State switch { "done" => "Ready", "queued" => "Queued", "retrying" => "Retrying", "converting" => "Converting", "failed" => "Failed", _ => "Not converted" };
                var tone = p.State switch { "done" => "vl-kw-success", "failed" => "vl-kw-danger", "none" => "vl-kw-secondary", _ => "vl-kw-info" };
                <li class="vl-pdf-item">
                    <div class="d-flex align-items-start gap-2">
                        <i class="bi @(p.Rendition != null ? "bi-file-earmark-pdf-fill text-danger" : "bi-file-earmark") fs-5 lh-1 mt-1" aria-hidden="true"></i>
                        <div class="min-w-0 flex-grow-1">
                            <div class="d-flex align-items-center gap-2">
                                <span class="fw-medium text-truncate">@(p.Rendition?.FileName ?? p.Original.FileName)</span>
                                <span class="vl-kw @tone ms-auto" data-pdf-pending="@(p.Pending ? p.Original.Id.ToString() : null)">
                                    @if (p.Pending) { <span class="spinner-border spinner-border-sm vl-pdf-spin" aria-hidden="true"></span> }
                                    else if (p.State == "done") { <i class="bi bi-check2" aria-hidden="true"></i> }
                                    else if (p.State == "failed") { <i class="bi bi-exclamation-triangle" aria-hidden="true"></i> }
                                    @stateLabel
                                </span>
                            </div>
                            <div class="x-small text-body-tertiary">
                                @m.FieldLabel(p.Original.FieldKey) · from @p.Original.FileName
                                @if (p.Rendition != null) { <text> · @Ui.FileSize(p.Rendition.Size) · @Ui.Time(p.Rendition.UploadedAt, tz)</text> }
                            </div>
                            @if (p.Job is { Watermark: { Length: > 0 } wm } && p.Rendition != null && p.Job.RenditionId == p.Rendition.Id)
                            {
                                <div class="x-small text-body-secondary mt-1"><i class="bi bi-droplet-half me-1" aria-hidden="true"></i>@wm</div>
                            }
                            @if (p.State == "failed" && p.Job?.LastError is { } err)
                            {
                                <div class="vl-pdf-error mt-1" role="alert">@err</div>
                            }
                            else if (p.State == "retrying" && p.Job is { } rj)
                            {
                                <div class="x-small text-body-secondary mt-1">Attempt @rj.Attempts failed: @rj.LastError Next try @Ui.Time(rj.NextAttemptAt, tz, relative: false).</div>
                            }
                            @if (p.Rendition != null)
                            {
                                <div class="d-flex flex-wrap gap-1 mt-2">
                                    <a class="btn btn-sm btn-light" href="/pdf/@p.Rendition.Id"><i class="bi bi-eye"></i>View</a>
                                    @if (m.Access.Download) { <a class="btn btn-sm btn-light" href="/pdf/@p.Rendition.Id?handler=Download"><i class="bi bi-download"></i>Download</a> }
                                    @if (m.Manifest && m.Access.Download) { <a class="btn btn-sm btn-light" href="/pdf/@p.Rendition.Id?handler=Copy" title="The rendition followed by the approval manifest (DOC-043)"><i class="bi bi-journal-check"></i>Controlled copy</a> }
                                </div>
                            }
                        </div>
                    </div>
                </li>
            }
        </ul>
        @if (m.Manifest)
        {
            <div class="vl-divider my-2"></div>
            <a class="btn btn-sm btn-light w-100" href="/pdf/manifest/@r.Id"><i class="bi bi-patch-check"></i>Approval manifest (PDF) · @Ui.Plural(m.Signatures, "signature")</a>
        }
        @if (m.RequiringPhases.Count > 0)
        {
            <div class="x-small text-body-tertiary mt-2"><i class="bi bi-shield-lock me-1" aria-hidden="true"></i>Current renditions are required to enter @string.Join(", ", m.RequiringPhases) (INV-054).</div>
        }
    </div>
</div>
