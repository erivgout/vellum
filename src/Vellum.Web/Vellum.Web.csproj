<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Vellum</RootNamespace>
    <UserSecretsId>vellum-dev</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Konscious.Security.Cryptography.Argon2" Version="1.3.1" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.13">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.13" />
    <PackageReference Include="Otp.NET" Version="1.4.1" />
    <!-- Pinned: 6.2.4 is the last MIT-licensed PDFsharp/MigraDoc release (later versions are AGPL). Don't upgrade without a license review. -->
    <PackageReference Include="PDFsharp" Version="6.2.4" />
    <PackageReference Include="PDFsharp-MigraDoc" Version="6.2.4" />
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup>
    <!-- Inter (SIL OFL 1.1) for generated PDFs: renditions, watermarks, approval manifests and record print views. -->
    <EmbeddedResource Include="Modules\Pdf\Fonts\*.ttf" LogicalName="VellumPdfFont.%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <Content Remove="App_Data\**" />
    <None Remove="App_Data\**" />
    <Watch Remove="App_Data\**" />
  </ItemGroup>

</Project>
