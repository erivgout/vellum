@page "/account/password"
@model Vellum.Pages.Account.PasswordModel
@{
    ViewData["Title"] = "Change password";
}
@section Crumbs { <a href="/account/profile">Account</a><i class="bi bi-chevron-right sep"></i><span class="current">Change password</span> }

<div class="row justify-content-center">
    <div class="col-lg-8 col-xl-6">
        <div class="vl-page-head">
            <div>
                <h1 class="vl-page-title">Change password</h1>
                <p class="vl-page-sub">Changing your password signs you out everywhere else.</p>
            </div>
        </div>
        @if (Model.Must || Model.Forced)
        {
            <div class="vl-banner vl-banner-warn"><i class="bi bi-key"></i><div><div class="ttl">You need to set a new password</div><div class="small">Your administrator reset your password or it expired. Choose a new one to continue.</div></div></div>
        }
        @if (Model.Errors.Count > 0)
        {
            <div class="vl-banner vl-banner-bad" role="alert"><i class="bi bi-exclamation-circle"></i><div><ul class="mt-0">@foreach (var e in Model.Errors) { <li>@e</li> }</ul></div></div>
        }
        <div class="card">
            <form method="post" class="card-body d-grid gap-3">
                <div>
                    <label class="form-label" for="cur">Current password</label>
                    <input type="password" class="form-control" id="cur" name="Current" autocomplete="current-password" required />
                </div>
                <div>
                    <label class="form-label" for="new">New password</label>
                    <input type="password" class="form-control" id="new" name="New" autocomplete="new-password" required />
                </div>
                <div>
                    <label class="form-label" for="conf">Confirm new password</label>
                    <input type="password" class="form-control" id="conf" name="Confirm" autocomplete="new-password" required />
                </div>
                <div class="vl-prompt"><i class="bi bi-shield-lock"></i>
                    <div><div class="fw-semibold mb-1">Password rules</div>
                        <ul class="mb-0 ps-3">@foreach (var r in Vellum.Engine.Security.PasswordPolicy.Describe(Model.Settings)) { <li>@r</li> }</ul>
                    </div>
                </div>
                <div class="d-flex gap-2">
                    <button class="btn btn-primary"><i class="bi bi-check2"></i>Change password</button>
                    @if (!Model.Must) { <a class="btn btn-light" href="/account/profile">Cancel</a> }
                </div>
            </form>
        </div>
    </div>
</div>
