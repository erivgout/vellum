@page "/error"
@model ErrorModel
@{
    ViewData["Title"] = Model.Code == 404 ? "Not found" : Model.Code == 403 ? "No access" : "Something went wrong";
    var signedIn = User.Identity?.IsAuthenticated == true;
    if (!signedIn) { Layout = "_AuthLayout"; }
}
<div class="d-flex align-items-center justify-content-center" style="min-height:60vh">
    <div class="text-center" style="max-width:460px">
        <div class="vl-empty-icon @(Model.Code == 404 ? "" : "tone-bad")" style="width:64px;height:64px;font-size:1.7rem"><i class="bi @(Model.Code == 404 ? "bi-signpost-split" : Model.Code == 403 ? "bi-lock" : "bi-exclamation-triangle")"></i></div>
        <div class="small fw-semibold text-body-tertiary mt-2">Error @Model.Code</div>
        <h1 class="h3 fw-bold mt-1">@ViewData["Title"]</h1>
        <p class="text-body-secondary">
            @(Model.Code == 404 ? "This page doesn't exist, or you don't have access to the record it shows." : Model.Code == 403 ? "You don't have permission to do that. Ask an application manager if you need access." : "The problem has been logged for your administrator. Your data hasn't been changed.")
        </p>
        <div class="d-flex justify-content-center gap-2 mt-3">
            <a class="btn btn-primary" href="/"><i class="bi bi-house"></i>Go home</a>
            <a class="btn btn-light" href="/search"><i class="bi bi-search"></i>Search</a>
        </div>
        @if (Model.Code >= 500) { <p class="x-small text-body-tertiary mt-4">Reference: <code>@Model.RequestId</code></p> }
    </div>
</div>
