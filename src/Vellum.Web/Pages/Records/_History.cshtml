@model Vellum.Pages.Records.RecordVm
@{
    var vm = Model;
    string Node(string action) => action switch
    {
        "Created" => "create",
        "Routed" or "System route" or "Handed off" or "Reassigned" => "route",
        "Signed" or "Vote" => "sign",
        "Routed back" or "Signature superseded" or "Lock broken" or "Lock expired" => "warn",
        "Voided" or "Administrative override" or "Field changed (override)" or "File integrity failure" => "bad",
        _ => "",
    };
    string Icon(string action) => action switch
    {
        "Created" => "bi-plus-lg",
        "Routed" or "System route" => "bi-arrow-right",
        "Routed back" => "bi-arrow-return-left",
        "Voided" => "bi-slash-circle",
        "Signed" => "bi-pen-fill",
        "Vote" => "bi-hand-thumbs-up",
        "Signature superseded" => "bi-pen",
        "Attachment added" or "Attachment removed" or "Attachment downloaded" or "Attachment viewed" => "bi-paperclip",
        "Comment added" or "System comment" => "bi-chat-left-text",
        "Locked" or "Unlocked" or "Lock broken" or "Lock expired" => "bi-lock",
        "Reassigned" or "Handed off" => "bi-person-gear",
        "Row added" or "Row removed" => "bi-table",
        "Link added" or "Activity created" => "bi-link-45deg",
        "Administrative override" or "Field changed (override)" => "bi-shield-exclamation",
        _ => "bi-pencil",
    };
    var fieldChanges = vm.Audit.Where(a => a.FieldKey != null && (a.Action.StartsWith("Field") || a.Action == "Field set")).GroupBy(a => a.FieldLabel ?? a.FieldKey).ToList();
    var noise = new HashSet<string> { "Locked", "Unlocked", "Attachment viewed" };
}
<ul class="nav vl-tabs" role="tablist" style="margin-top:-.25rem">
    <li class="nav-item"><button type="button" class="nav-link active" data-bs-toggle="tab" data-bs-target="#h-audit" role="tab"><i class="bi bi-clock-history"></i>Audit trail <span class="vl-pill-count">@vm.Audit.Count</span></button></li>
    <li class="nav-item"><button type="button" class="nav-link" data-bs-toggle="tab" data-bs-target="#h-fields" role="tab"><i class="bi bi-input-cursor-text"></i>Field history</button></li>
    <li class="nav-item"><button type="button" class="nav-link" data-bs-toggle="tab" data-bs-target="#h-phases" role="tab"><i class="bi bi-signpost-2"></i>Phase tracking</button></li>
    <li class="nav-item"><button type="button" class="nav-link" data-bs-toggle="tab" data-bs-target="#h-email" role="tab"><i class="bi bi-envelope"></i>Email log <span class="vl-pill-count">@vm.Emails.Count</span></button></li>
</ul>
<div class="tab-content">
    <div class="tab-pane fade show active" id="h-audit" role="tabpanel">
        <div class="d-flex align-items-center justify-content-between mb-2 flex-wrap gap-2">
            <div class="small text-body-secondary"><i class="bi bi-link-45deg"></i> Append-only and hash-chained (PLT-1006). Each entry seals the previous one.</div>
            <div class="d-flex gap-2">
                <a class="btn btn-sm btn-light" href="/records/@vm.Record!.Id/audit.csv"><i class="bi bi-filetype-csv"></i>CSV</a>
                <a class="btn btn-sm btn-light" href="/records/@vm.Record.Id/audit.json"><i class="bi bi-filetype-json"></i>JSON</a>
            </div>
        </div>
        <div class="card"><div class="card-body">
            <ul class="vl-timeline">
                @foreach (var a in vm.Audit.Where(a => !noise.Contains(a.Action)))
                {
                    <li class="vl-tl-item">
                        <span class="vl-tl-node @Node(a.Action)"><i class="bi @Icon(a.Action)"></i></span>
                        <div class="vl-tl-body">
                            <div class="vl-tl-head">
                                <b>@a.UserName</b>
                                @if (a.OnBehalfOfName != null) { <span class="text-body-secondary">on behalf of <b>@a.OnBehalfOfName</b></span> }
                                <span class="text-body-secondary">@a.Action.ToLowerInvariant()</span>
                                @if (a.FieldLabel != null) { <b>@a.FieldLabel</b> }
                                @if (a.Detail != null && a.FieldLabel == null) { <span>· @a.Detail</span> }
                            </div>
                            <div class="vl-tl-meta">
                                @Ui.Time(a.At, vm.Tz, relative: false) · #@a.Seq
                                @if (a.PhaseName != null) { <span> · @a.PhaseName</span> }
                                · @a.Source
                                @if (a.ActorKind == ActorKind.System) { <span class="vl-kw ms-1" style="font-size:.66rem">System</span> }
                                <span class="vl-hash ms-1" title="Entry hash @a.Hash · previous @a.PrevHash">@a.Hash[..10]</span>
                            </div>
                            @if (a.OldValue != null || a.NewValue != null)
                            {
                                <div class="vl-diff">
                                    @if (!string.IsNullOrEmpty(a.OldValue)) { <span class="k">Was</span><span class="old">@a.OldValue</span> }
                                    @if (!string.IsNullOrEmpty(a.NewValue)) { <span class="k">Now</span><span class="new">@a.NewValue</span> }
                                </div>
                            }
                            @if (a.Reason != null) { <div class="small mt-1"><i class="bi bi-chat-quote text-body-tertiary"></i> @a.Reason</div> }
                        </div>
                    </li>
                }
            </ul>
        </div></div>
    </div>

    <div class="tab-pane fade" id="h-fields" role="tabpanel">
        @if (fieldChanges.Count == 0)
        {
            <div class="vl-empty"><div class="vl-empty-icon"><i class="bi bi-input-cursor"></i></div><h3>No field changes yet</h3></div>
        }
        <div class="row g-3">
            @foreach (var g in fieldChanges)
            {
                <div class="col-12">
                    <div class="card">
                        <div class="card-header py-2"><h3 class="card-title-sm">@g.Key</h3><span class="vl-pill-count ms-auto">@g.Count()</span></div>
                        <div class="table-responsive">
                            <table class="table vl-table vl-table-compact">
                                <thead><tr><th>When</th><th>Who</th><th>Phase</th><th>Old value</th><th>New value</th><th>Signed</th></tr></thead>
                                <tbody>
                                    @foreach (var a in g)
                                    {
                                        var signed = vm.Signatures.Any(s => s.RecordVersion >= (a.RecordVersion ?? 0) && Math.Abs((s.SignedAt - a.At).TotalHours) < 72 && !s.Superseded);
                                        <tr>
                                            <td class="text-nowrap">@Ui.Time(a.At, vm.Tz, relative: false)</td>
                                            <td class="text-nowrap">@a.UserName</td>
                                            <td class="text-nowrap text-body-secondary">@a.PhaseName</td>
                                            <td class="text-body-secondary">@(a.OldValue ?? "–")</td>
                                            <td>@(a.NewValue ?? "–")</td>
                                            <td>@if (signed) { <i class="bi bi-pen text-body-tertiary" title="A signature exists on this or a later version"></i> }</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>

    <div class="tab-pane fade" id="h-phases" role="tabpanel">
        <div class="vl-table-wrap"><div class="vl-table-scroll">
            <table class="table vl-table">
                <thead><tr><th>Phase</th><th>Entered</th><th>Due</th><th>Exited</th><th>By</th><th>Action</th><th>Comment</th><th>Config</th></tr></thead>
                <tbody>
                    @foreach (var e in vm.PhaseEntries.AsEnumerable().Reverse())
                    {
                        var onTime = e.DueDate != null && e.ExitedAt != null ? (DateOnly.FromDateTime(e.ExitedAt.Value) <= e.DueDate ? "early" : "late") : null;
                        <tr>
                            <td class="fw-medium text-nowrap">@e.PhaseName</td>
                            <td class="text-nowrap">@Ui.Time(e.EnteredAt, vm.Tz, relative: false)<div class="x-small text-body-tertiary">@vm.Dir.Name(e.EnteredById)</div></td>
                            <td class="text-nowrap">@(e.DueDate?.ToString("dd MMM yyyy") ?? "–")</td>
                            <td class="text-nowrap">@if (e.ExitedAt is { } x) { @Ui.Time(x, vm.Tz, relative: false) if (onTime == "late") { <span class="vl-kw vl-kw-danger ms-1">Late</span> } else if (onTime == "early") { <span class="vl-kw vl-kw-success ms-1">On time</span> } } else { <span class="vl-chip vl-chip-open"><i class="bi bi-circle-fill vl-dot"></i>Current</span> }</td>
                            <td class="text-nowrap">@(e.ExitedById != null ? vm.Dir.Name(e.ExitedById) : "")</td>
                            <td class="text-nowrap text-body-secondary">@e.ExitAction</td>
                            <td class="small">@e.Comment</td>
                            <td class="text-body-tertiary">v@(e.ConfigVersion)</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div></div>
    </div>

    <div class="tab-pane fade" id="h-email" role="tabpanel">
        @if (vm.Emails.Count == 0)
        {
            <div class="vl-empty"><div class="vl-empty-icon"><i class="bi bi-envelope"></i></div><h3>No email sent about this record</h3></div>
        }
        else
        {
            <div class="vl-table-wrap"><div class="vl-table-scroll">
                <table class="table vl-table">
                    <thead><tr><th>Sent</th><th>To</th><th>Subject</th><th>Status</th></tr></thead>
                    <tbody>
                        @foreach (var m in vm.Emails)
                        {
                            <tr><td class="text-nowrap">@Ui.Time(m.At, vm.Tz, relative: false)</td><td>@m.To</td><td>@m.Subject<div class="x-small text-body-tertiary text-truncate-2">@m.Body</div></td><td>@Ui.KeywordBadge(m.Status, m.Status == "Delivered" ? "success" : m.Status == "Queued" ? "warning" : "danger")</td></tr>
                        }
                    </tbody>
                </table>
            </div></div>
        }
    </div>
</div>
