@page "/insights/alerts/reports/{id:long}"
@model Vellum.Areas.Insights.Pages.Alerts.ReportModel
@{
    var r = Model.R;
    var t = Model.T;
    ViewData["Title"] = r.Number;
    string O(string k) => Model.Origin.TryGetProperty(k, out var v) && v.ValueKind != System.Text.Json.JsonValueKind.Null ? (v.ValueKind == System.Text.Json.JsonValueKind.Array ? string.Join(", ", v.EnumerateArray().Select(x => x.ToString())) : v.ToString()) : "–";
    var matchCols = Model.Result.Columns.Where(c => c.Match).ToList();
    var extraCols = Model.Result.Columns.Where(c => !c.Match).ToList();
    var creates = t.Action == "create";
    var createdCount = Model.Creations.Count(c => c.Status == "Created");
    var createdKeys = Model.Creations.Where(c => c.Status == "Created").Select(c => c.ItemKey).ToHashSet();
    // A failure followed by a successful retry for the same item is shown as an earlier attempt.
    bool Superseded(InsightsAlertCreation c) => c.Status == "Failed" && createdKeys.Contains(c.ItemKey);
    var failedCount = Model.Creations.Where(c => c.Status is "Failed" or "PreviewFailed" && !Superseded(c)).Select(c => c.ItemKey).Distinct().Count();
}
@section Crumbs {
    <a href="/insights">Insights</a><i class="bi bi-chevron-right sep" aria-hidden="true"></i>
    <a href="/insights/alerts?tab=reports">Alert reports</a><i class="bi bi-chevron-right sep" aria-hidden="true"></i>
    <span class="current">@r.Number</span>
}

<div class="vl-page-head align-items-center">
    <div class="min-w-0 flex-grow-1">
        <div class="d-flex align-items-center gap-2 flex-wrap">
            <h1 class="vl-page-title">@t.Name</h1>
            <span class="vl-kw">@r.Number</span>
            @if (r.IsTest) { <span class="vl-kw vl-kw-violet">Test report</span> }
            <partial name="_ActionStatus" model="r" />
        </div>
        <p class="vl-page-sub">Generated @Ui.Time(r.GeneratedAt, Shell.TimeZone, relative: false) · @Ui.Plural(r.GroupCount, "group") reached the minimum · @Ui.Plural(r.RecordCount, "record")</p>
    </div>
    <div class="d-flex flex-wrap gap-2">
        @if (Model.CanRetry)
        {
            <form method="post" action="/insights/alerts/reports/@r.Id?handler=Retry" class="m-0">@Html.AntiForgeryToken()
                <button class="btn btn-primary" title="Create the records that are still missing. Records already created for this report are never created again."><i class="bi bi-arrow-clockwise" aria-hidden="true"></i>Retry missing records</button>
            </form>
        }
        <a class="btn btn-light" href="/insights/alerts/reports/@r.Id?handler=Json"><i class="bi bi-filetype-json" aria-hidden="true"></i>Data (JSON)</a>
        <a class="btn btn-light" href="/insights/alerts/@t.Id"><i class="bi bi-bell" aria-hidden="true"></i>Alert @t.Number</a>
    </div>
</div>

@if (r.ActionStatus == "Failed")
{
    <div class="vl-banner vl-banner-bad" role="alert">
        <i class="bi bi-exclamation-octagon-fill" aria-hidden="true"></i>
        <div>
            <div class="ttl">@(r.IsTest ? (creates ? "A real run would fail" : "The alert's action would fail") : "The alert's action failed")</div>
            @r.ActionDetail
            @if (creates && failedCount > 0) { <div class="small mt-1">Nothing was created for the failed @(failedCount == 1 ? "item" : "items"): a record is only created when every required field has a value (INV-127).</div> }
            @if (!r.IsTest) { <div class="small mt-1">The owner and every administrator were sent a safety-critical alert about this failure.</div> }
        </div>
    </div>
}
else if (r.ActionDetail != null)
{
    <div class="vl-banner vl-banner-info" role="status"><i class="bi bi-info-circle-fill" aria-hidden="true"></i><div>@r.ActionDetail</div></div>
}
@if (Model.Hidden > 0)
{
    <div class="vl-banner vl-banner-warn" role="status"><i class="bi bi-shield-lock" aria-hidden="true"></i><div>Some matched records aren't shown because you don't have access to them.</div></div>
}

<div class="row g-4">
    <div class="col-lg-4">
        <section class="card mb-4">
            <div class="card-header"><h2 class="card-title-sm"><i class="bi bi-diagram-2" aria-hidden="true"></i>Origin</h2></div>
            <div class="card-body">
                <dl class="ins-origin">
                    <dt>Alert</dt><dd>@O("template") · @O("name")</dd>
                    <dt>Application</dt><dd>@O("application")</dd>
                    <dt>Forms</dt><dd>@O("forms")</dd>
                    <dt>View</dt><dd>@O("view")</dd>
                    <dt>Match columns</dt><dd>@string.Join(", ", matchCols.Select(c => c.Label))</dd>
                    <dt>Minimum</dt><dd>@O("minimum")</dd>
                    <dt>Look back</dt><dd>@(O("lookbackDays") == "–" ? "Every record" : O("lookbackDays") + " days")</dd>
                    <dt>Frequency</dt><dd>Every @O("frequencyDays") day(s)</dd>
                    <dt>Window</dt><dd>@O("windowStart") – @O("windowEnd")</dd>
                    <dt>Evaluated</dt><dd>@Ui.Plural(Model.Result.Evaluated, "record") as @O("owner")@(Model.Result.Truncated ? " (truncated)" : "")</dd>
                </dl>
            </div>
        </section>
    </div>
    <div class="col-lg-8 min-w-0">
        @if (Model.Creations.Count > 0)
        {
            <section class="card mb-4" aria-labelledby="ins-created-title">
                <div class="card-header d-flex align-items-center gap-2">
                    <h2 class="card-title-sm" id="ins-created-title"><i class="bi bi-file-earmark-plus" aria-hidden="true"></i>@(r.IsTest ? "Records this alert would create" : "Records created")</h2>
                    <span class="ms-auto small text-body-tertiary">@(r.IsTest ? "Dry run: nothing was created, numbered, linked or sent" : $"{createdCount} created" + (failedCount > 0 ? $" · {failedCount} failed" : ""))</span>
                </div>
                <ul class="ins-created">
                    @foreach (var c in Model.Creations)
                    {
                        var d = ReportModel.Detail(c);
                        var canOpen = c.RecordId is { } rid && Model.VisibleCreated.Contains(rid);
                        <li>
                            <div class="ins-created-head">
                                @switch (Superseded(c) ? "Earlier" : c.Status)
                                {
                                    case "Earlier": <span class="vl-chip vl-chip-archived"><i class="bi bi-clock-history" aria-hidden="true"></i>Earlier attempt failed</span> break;
                                    case "Created": <span class="vl-chip vl-chip-done"><i class="bi bi-check2-circle" aria-hidden="true"></i>Created</span> break;
                                    case "Preview": <span class="vl-chip vl-chip-draft"><i class="bi bi-eye" aria-hidden="true"></i>Would create</span> break;
                                    case "PreviewFailed": <span class="vl-chip vl-chip-overdue"><i class="bi bi-x-octagon" aria-hidden="true"></i>Would fail</span> break;
                                    case "Skipped": <span class="vl-chip vl-chip-archived"><i class="bi bi-skip-forward" aria-hidden="true"></i>Skipped</span> break;
                                    default: <span class="vl-chip vl-chip-overdue"><i class="bi bi-exclamation-octagon-fill" aria-hidden="true"></i>Not created</span> break;
                                }
                                <span class="ins-created-rec min-w-0">
                                    @if (c.Status == "Created")
                                    {
                                        if (canOpen) { <a href="/records/@c.RecordId"><span class="num">@c.RecordNumber</span>@c.RecordTitle</a> }
                                        else { <span class="num">@c.RecordNumber</span><span class="text-body-tertiary">(you can't open this record)</span> }
                                    }
                                    else if (c.Status == "Preview") { <span>@(d?.Title ?? c.RecordTitle)</span> }
                                    else { <span>@(d?.Form ?? "Record")</span> }
                                </span>
                                <span class="ins-created-item ms-auto">For @c.ItemLabel</span>
                            </div>
                            @if (c.Message != null)
                            {
                                <div class="ins-created-msg @(c.Status is "Failed" or "PreviewFailed" && !Superseded(c) ? "bad" : "")">@c.Message</div>
                            }
                            @if (d != null && c.Status is "Created" or "Preview" or "Failed" or "PreviewFailed")
                            {
                                <details>
                                    <summary>@(c.Status is "Created" ? "What was set" : c.Status is "Preview" ? "What would be set" : "What the action tried to set")</summary>
                                    <div class="ins-created-detail">
                                        <dl class="ins-origin">
                                            <dt>Form</dt><dd>@d.App › @d.Form</dd>
                                            <dt>Phase</dt><dd>@(d.Phase ?? "–")</dd>
                                            <dt>Due</dt><dd>@(d.Due?.ToString("dd MMM yyyy") ?? "–")</dd>
                                            <dt>Assigned to</dt><dd>@(d.Assignees.Count > 0 ? string.Join(", ", d.Assignees) : "–")</dd>
                                            <dt>Notify</dt><dd>@(d.Notify.Count > 0 ? string.Join(", ", d.Notify) : "Assignees only")</dd>
                                            <dt>Linked to</dt><dd>@(d.Sources.Count > 0 ? string.Join(", ", d.Sources) : "–")</dd>
                                        </dl>
                                        <table class="ins-created-fields">
                                            <caption class="visually-hidden">Field values</caption>
                                            <tbody>
                                                @foreach (var f in d.Fields)
                                                {
                                                    <tr>
                                                        <th scope="row">@f.Label@if (f.Required) { <span class="visually-hidden"> (required)</span><span class="text-danger" aria-hidden="true"> *</span> }</th>
                                                        <td>
                                                            @if (f.Value.Length > 0) { @f.Value } else if (f.Required) { <span class="text-danger"><i class="bi bi-exclamation-circle" aria-hidden="true"></i> No value</span> } else { <span class="text-body-tertiary">–</span> }
                                                            @if (f.Value.Length > 0) { <span class="ins-origin-tag">@(f.Origin == "alert" ? "from alert" : "form default")</span> }
                                                        </td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                    @if (d.Notes.Count > 0) { <ul class="small text-body-secondary mt-2 mb-0 ps-3">@foreach (var n in d.Notes) { <li>@n</li> }</ul> }
                                </details>
                            }
                        </li>
                    }
                </ul>
            </section>
        }
        else if (creates && r.ActionStatus == "Pending")
        {
            <div class="vl-banner vl-banner-info" role="status"><i class="bi bi-hourglass-split" aria-hidden="true"></i><div>The create-record action hasn't finished. The next run resumes it without creating anything twice.</div></div>
        }
        @if (Model.Result.Groups.Count == 0)
        {
            <div class="card"><div class="vl-empty"><div class="vl-empty-icon tone-ok"><i class="bi bi-check2-all"></i></div><h3>No group reached the minimum</h3><p>Nothing matched the threshold when this report ran.</p></div></div>
        }
        @foreach (var g in Model.Result.Groups)
        {
            var rows = g.Records.Where(x => Model.Visible.Contains(x.Id)).ToList();
            <section class="card mb-3">
                <div class="ins-group-head">
                    @for (var i = 0; i < matchCols.Count && i < g.Values.Count; i++)
                    {
                        <span><span class="text-body-tertiary small">@matchCols[i].Label</span> <span class="vals">@g.Values[i]</span></span>
                    }
                    <span class="ms-auto vl-kw vl-kw-danger">@Ui.Plural(g.Count, "record")</span>
                </div>
                @if (rows.Count > 0)
                {
                    <div class="vl-table-scroll">
                        <table class="table vl-table vl-table-compact mb-0">
                            <thead><tr><th scope="col">Number</th><th scope="col">Title</th>@foreach (var c in matchCols.Concat(extraCols)) { <th scope="col">@c.Label</th> }</tr></thead>
                            <tbody>
                                @foreach (var x in rows)
                                {
                                    <tr data-href="/records/@x.Id">
                                        <td class="col-number"><a href="/records/@x.Id">@x.Number</a></td>
                                        <td class="col-title"><span class="t">@x.Title</span></td>
                                        @foreach (var c in matchCols.Concat(extraCols)) { <td class="text-body-secondary">@(x.Cells.GetValueOrDefault(c.Key) is { Length: > 0 } v ? v : "–")</td> }
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </section>
        }
    </div>
</div>
