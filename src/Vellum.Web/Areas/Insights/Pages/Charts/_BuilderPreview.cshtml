@model Vellum.Areas.Insights.Pages.Charts.EditModel
@{
    var p = Model.Preview;
}
@if (p == null)
{
    <div class="ins-empty"><i class="bi bi-bar-chart" aria-hidden="true"></i><span>Choose an application and a view to start.</span></div>
}
else if (!p.Ok)
{
    <div class="vl-banner vl-banner-warn mb-0" role="status">
        <i class="bi bi-exclamation-triangle-fill" aria-hidden="true"></i>
        <div>
            <div class="ttl">Adjust the chart settings</div>
            <ul class="ins-issues">@foreach (var i in p.Issues.Select(i => i.Message).Distinct()) { <li>@i</li> }</ul>
        </div>
    </div>
}
else
{
    <div class="d-flex flex-wrap gap-2 mb-3">
        <span class="vl-kw"><i class="bi bi-calendar3" aria-hidden="true"></i>@p.RangeText</span>
        <span class="vl-kw">@Ui.Plural(p.Records, "record")</span>
        @if (p.Truncated) { <span class="vl-kw vl-kw-warning">Only the first @ChartEngine.MaxRows.ToString("N0") records are charted</span> }
    </div>
    @ChartRenderer.Figure(p.Chart!, TableMode.Open, 700)
}
