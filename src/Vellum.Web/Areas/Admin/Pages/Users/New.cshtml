@page
@model Vellum.Areas.Admin.Pages.Users.NewModel
@{
    ViewData["Title"] = "New user";
}
@section Crumbs { <a href="/admin/users">Users</a><i class="bi bi-chevron-right sep" aria-hidden="true"></i><span class="current">New user</span> }

<div class="vl-page-head align-items-center">
    <span class="adm-head-icon tone-info"><i class="bi bi-person-plus"></i></span>
    <div class="flex-grow-1 min-w-0">
        <h1 class="vl-page-title">New user</h1>
        <p class="vl-page-sub">Create a local account. The person gets a welcome email without the password (SEC-709).</p>
    </div>
</div>

<partial name="_Errors" model="Model.Errors" />

<form method="post" class="row g-4" autocomplete="off">
    <div class="col-xl-8">
        <div class="card">
            <div class="card-body">
                <partial name="_UserFields" model="Model.Form" />
            </div>
        </div>
    </div>
    <div class="col-xl-4">
        <div class="card adm-sticky">
            <div class="card-header"><h2 class="card-title-sm"><i class="bi bi-key"></i>Temporary password</h2></div>
            <div class="card-body d-grid gap-3">
                <div>
                    <label class="form-label" for="u-pw">Password <span class="req">*</span></label>
                    <div class="input-group">
                        <input class="form-control mono" type="password" id="u-pw" name="Password" required autocomplete="new-password" spellcheck="false" />
                        <button class="btn btn-light" type="button" data-adm-reveal="#u-pw" aria-label="Show password"><i class="bi bi-eye"></i></button>
                        <button class="btn btn-light" type="button" data-adm-genpw="#u-pw" data-adm-min="@Model.Settings.PasswordMinLength"><i class="bi bi-magic"></i>Generate</button>
                    </div>
                </div>
                <ul class="adm-policy" aria-label="Password rules">
                    @foreach (var rule in Model.Policy) { <li><i class="bi bi-check2"></i>@rule</li> }
                </ul>
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" id="u-must" name="MustChange" value="true" checked="@Model.MustChange" />
                    <label class="form-check-label" for="u-must">Require a new password at first sign-in <span class="vl-kw vl-kw-success ms-1">Recommended</span></label>
                    <input type="hidden" name="MustChange" value="false" />
                </div>
                <div class="vl-prompt"><i class="bi bi-info-circle"></i><div class="small">Give the password to the person over a separate channel. It's never stored, logged or emailed (INV-151).</div></div>
                <div class="d-flex gap-2">
                    <button class="btn btn-primary flex-grow-1"><i class="bi bi-person-check"></i>Create user</button>
                    <a class="btn btn-light" href="/admin/users">Cancel</a>
                </div>
            </div>
        </div>
    </div>
</form>

<script type="application/json" id="vl-directory">@Html.Raw(System.Text.Json.JsonSerializer.Serialize(Shell.Directory.All.Where(u => u.Status != UserStatus.Inactive).Select(u => new { id = u.Id, name = u.DisplayName, initials = u.Initials, title = u.JobTitle, hue = u.Hue })))</script>
