@page "/portal/account/password"
@model Vellum.Areas.Portal.Pages.Account.PasswordModel
@{
    ViewData["Title"] = "Change password";
}
<nav class="vp-crumbs" aria-label="Breadcrumb"><a href="/portal">Home</a><i class="bi bi-chevron-right" aria-hidden="true"></i><a href="/portal/account">Account</a><i class="bi bi-chevron-right" aria-hidden="true"></i><span aria-current="page">Change password</span></nav>
<div class="row justify-content-center">
    <div class="col-lg-7 col-xl-6">
        <div class="vp-page-head"><div><h1 class="vp-title">Change password</h1><p class="vp-lead">Changing your password signs you out on every other device.</p></div></div>
        @if (Model.Must || Model.Forced)
        {
            <div class="vl-banner vl-banner-warn"><i class="bi bi-key" aria-hidden="true"></i><div><div class="ttl">Choose a new password to continue</div><div class="small">Your password expired or was reset.</div></div></div>
        }
        @if (Model.Errors.Count > 0)
        {
            <div class="vl-banner vl-banner-bad" role="alert"><i class="bi bi-exclamation-circle" aria-hidden="true"></i><div><ul class="mb-0">@foreach (var e in Model.Errors) { <li>@e</li> }</ul></div></div>
        }
        <form method="post" class="vp-card vp-card-body d-grid gap-3">
            <div>
                <label class="form-label" for="cur">Current password</label>
                <div class="input-group"><input type="password" class="form-control" id="cur" name="current" autocomplete="current-password" required /><button type="button" class="btn btn-light" data-toggle-password="#cur" aria-label="Show password"><i class="bi bi-eye" aria-hidden="true"></i></button></div>
            </div>
            <div>
                <label class="form-label" for="new">New password</label>
                <div class="input-group"><input type="password" class="form-control" id="new" name="new" autocomplete="new-password" required aria-describedby="rules" /><button type="button" class="btn btn-light" data-toggle-password="#new" aria-label="Show password"><i class="bi bi-eye" aria-hidden="true"></i></button></div>
            </div>
            <div>
                <label class="form-label" for="conf">Confirm new password</label>
                <input type="password" class="form-control" id="conf" name="confirm" autocomplete="new-password" required />
            </div>
            <div class="vl-prompt" id="rules"><i class="bi bi-shield-lock" aria-hidden="true"></i>
                <div><div class="fw-semibold mb-1">Password rules</div><ul class="mb-0 ps-3">@foreach (var r in Vellum.Engine.Security.PasswordPolicy.Describe(Model.Settings)) { <li>@r</li> }</ul></div>
            </div>
            <div class="d-flex gap-2">
                <button class="btn btn-primary"><i class="bi bi-check2" aria-hidden="true"></i>Change password</button>
                @if (!Model.Must) { <a class="btn btn-light" href="/portal/account">Cancel</a> }
            </div>
        </form>
    </div>
</div>
