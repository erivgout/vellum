@page "/documents/reviews"
@model Vellum.Areas.Documents.Pages.ReviewsModel
@{
    ViewData["Title"] = "Periodic review schedule";
    ViewData["ActiveApp"] = "documents";
    string Href(string w) => $"/documents/reviews?window={w}" + (string.IsNullOrEmpty(Model.Q) ? "" : "&q=" + Uri.EscapeDataString(Model.Q));
}
@section Crumbs {
    <a href="/apps">Applications</a><i class="bi bi-chevron-right sep"></i>
    <a href="/apps/documents">Document Control</a><i class="bi bi-chevron-right sep"></i>
    <span class="current">Review schedule</span>
}

<div class="vl-page-head">
    <div>
        <h1 class="vl-page-title">Periodic review schedule</h1>
        <p class="vl-page-sub">Effective documents by next review date. The date is calculated on release from the type profile's frequency and reset by each completed periodic review (DOC-071, DOC-074). Owners get reminders 30 days before and when overdue (DOC-072).</p>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-6 col-xl-3">
        <a class="vl-stat" href="@Href("overdue")">
            <span class="vl-stat-icon @(Model.Counts["overdue"] > 0 ? "tone-bad" : "tone-ok")"><i class="bi @(Model.Counts["overdue"] > 0 ? "bi-exclamation-octagon-fill" : "bi-check-circle-fill")"></i></span>
            <div class="vl-stat-value @(Model.Counts["overdue"] > 0 ? "text-danger" : "")">@Model.Counts["overdue"]</div>
            <div class="vl-stat-label">Overdue reviews</div>
        </a>
    </div>
    <div class="col-6 col-xl-3">
        <a class="vl-stat" href="@Href("30")">
            <span class="vl-stat-icon tone-warn"><i class="bi bi-hourglass-split"></i></span>
            <div class="vl-stat-value">@Model.Counts["30"]</div>
            <div class="vl-stat-label">Due within 30 days</div>
        </a>
    </div>
    <div class="col-6 col-xl-3">
        <a class="vl-stat" href="@Href("90")">
            <span class="vl-stat-icon tone-info"><i class="bi bi-calendar-week"></i></span>
            <div class="vl-stat-value">@Model.Counts["90"]</div>
            <div class="vl-stat-label">Due within 90 days</div>
        </a>
    </div>
    <div class="col-6 col-xl-3">
        <div class="vl-stat">
            <span class="vl-stat-icon tone-violet"><i class="bi bi-calendar2-check-fill"></i></span>
            <div class="vl-stat-value">@Model.OpenReviews</div>
            <div class="vl-stat-label">Reviews in progress · @Model.Counts["all"] effective documents</div>
        </div>
    </div>
</div>

<div class="card">
    <div class="card-header flex-wrap gap-2">
        <div class="vl-filter-pills" role="tablist" aria-label="Review window">
            @foreach (var (key, label) in Vellum.Areas.Documents.Pages.ReviewsModel.Windows)
            {
                <a class="@(Model.Window == key ? "active" : "")" href="@Href(key)" aria-current="@(Model.Window == key ? "page" : null)">@label <span class="vl-pill-count @(key == "overdue" && Model.Counts[key] > 0 ? "hot" : "")">@Model.Counts[key]</span></a>
            }
        </div>
        <form method="get" action="/documents/reviews" class="ms-auto d-flex gap-2" role="search">
            <input type="hidden" name="window" value="@Model.Window" />
            <input type="search" name="q" value="@Model.Q" class="form-control form-control-sm" placeholder="Number or title…" aria-label="Search documents" />
            <button class="btn btn-sm btn-light" type="submit"><i class="bi bi-search"></i><span class="visually-hidden">Search</span></button>
        </form>
    </div>
    @if (Model.Rows.Count == 0)
    {
        <div class="vl-empty">
            <div class="vl-empty-icon tone-ok"><i class="bi bi-calendar2-check"></i></div>
            <h3>Nothing due</h3>
            <p>No effective documents match this review window.</p>
        </div>
    }
    else
    {
        <div class="vl-table-scroll">
            <table class="table vl-table mb-0">
                <thead>
                    <tr><th scope="col">Next review</th><th scope="col">Number</th><th scope="col">Title</th><th scope="col">Type</th><th scope="col">Owner</th><th scope="col">Effective</th><th scope="col">Last reviewed</th><th scope="col">Review</th></tr>
                </thead>
                <tbody>
                    @foreach (var row in Model.Rows)
                    {
                        var i = row.Info;
                        <tr data-href="/records/@i.Doc.Id">
                            <td class="text-nowrap">@if (i.NextReview == null) { <span class="text-body-tertiary">Not scheduled</span> } else { @Ui.Due(i.NextReview) }</td>
                            <td class="col-number text-nowrap"><a href="/records/@i.Doc.Id">@i.Doc.Number</a> <span class="vl-kw">Rev @i.Doc.Revision</span></td>
                            <td class="col-title"><span class="t">@i.Doc.Title</span></td>
                            <td>@if (row.TypeLabel != null) { @Ui.KeywordBadge(row.TypeLabel, row.TypeColor) }</td>
                            <td>@Ui.Avatar(Shell.Directory.Get(i.OwnerId), "xs", showName: true)</td>
                            <td class="text-nowrap">@i.Doc.EffectiveDate?.ToString("dd MMM yyyy")</td>
                            <td class="text-nowrap">@(i.LastReviewed?.ToString("dd MMM yyyy") ?? "–")</td>
                            <td class="text-nowrap">
                                @if (i.OpenReview != null) { <a href="/records/@i.OpenReview.Id" class="vl-kw vl-kw-violet"><i class="bi bi-calendar2-check"></i>@i.OpenReview.Number in progress</a> }
                                else if (i.Months > 0) { <span class="small text-body-secondary">Every @i.Months months</span> }
                                else { <span class="small text-body-tertiary">No periodic review</span> }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
